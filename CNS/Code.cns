[StateDef 10004];parentリダイレクト参照アドレスを0からvar(59)にする
type=U
movetype=U
physics=U
juggle=0
hitdefpersist=1
movehitpersist=1
hitcountpersist=1

[State ];4Byte目をそろえる
type = SelfState
trigger1 = var(58) = 4
trigger1 = var(58) := 3
trigger1 = ((var(59)/16777216)&255)
trigger1 = var(58) := ((var(59)/16777216)&255)
value = 10000 + ifelse(var(58)<128,4127,var(58)) + (var(58):=var(58)+4000)*0
ignorehitpause = 1

[State ];3Byte目をそろえる
type = SelfState
trigger1 = var(58) = 3
trigger1 = var(58) := 2
trigger1 = ((var(59)/65536)&255)
trigger1 = var(58) := ((var(59)/65536)&255)
value = 10000 + ifelse(var(58)<128,3127,var(58)) + (var(58):=var(58)+3000)*0
ignorehitpause = 1

[State ];2Byte目をそろえる
type = SelfState
trigger1 = var(58) = 2
trigger1 = var(58) := 1
trigger1 = ((var(59)/256)&255)
trigger1 = var(58) := ((var(59)/256)&255)
value = 10000 + ifelse(var(58)<128,2127,var(58)) + (var(58):=var(58)+2000)*0
ignorehitpause = 1

[State ];1Byte目をそろえる
type = SelfState
trigger1 = var(58) = 1
trigger1 = var(58) := 0 || 1
trigger1 = (var(59)&255)
trigger1 = var(58) := (var(59)&255)
value = 10000 + ifelse(var(58)<128,1127,var(58)) + (var(58):=var(58)+1000)*0
ignorehitpause = 1

[State ]
type = SelfState
trigger1 = var(58) = 0
value = 10005
persistent = 256
ignorehitpause = 1



